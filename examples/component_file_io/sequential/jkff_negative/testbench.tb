# jkff_negative clocked input file with expected-output assertions
NETLIST examples/component_file_io/sequential/jkff_negative/netlist.table
CLOCK clk 10
MAX_TIME 50
@0 j=0 k=0
@7 j=1 k=0
@17 j=0 k=1
@27 j=1 k=1
@37 j=0 k=0

# Expected values sampled after negative clock edges.
ASSERT @10 q=1 "JK set on negative edge"
ASSERT @20 q=0 "JK reset on negative edge"
ASSERT @30 q=1 "JK toggle on negative edge"
ASSERT @40 q=1 "JK hold on negative edge"
ASSERT @50 q=1 "JK hold on negative edge"
