# tff_positive clocked input file with expected-output assertions
NETLIST examples/component_file_io/sequential/tff_positive/netlist.table
CLOCK clk 10
MAX_TIME 50
@0 t=0
@10 t=1
@20 t=1
@30 t=0
@40 t=1

# Expected values sampled after positive clock edges.
ASSERT @5 q=0 "TFF holds when T is zero"
ASSERT @15 q=1 "TFF toggles to one"
ASSERT @25 q=0 "TFF toggles to zero"
ASSERT @35 q=0 "TFF holds when T is zero"
ASSERT @45 q=1 "TFF toggles to one"
